#!/usr/bin/env ruby
# frozen_string_literal: true

# Fails unless a published gem version carries its sigstore attestation on RubyGems.org
# (script/release_attestation.rb, #297).
#
#   script/check-release-attestation NAME VERSION
#
# Asks for up to five minutes while the registry does not know the version yet. Exits 0 when
# the version is attested, and 1 with an `::error::` line when it was published unsigned or no
# verdict was reached. It reads no credential and sends none: the endpoint is public.
require_relative "release_attestation"

exit ReleaseAttestation.run(ARGV)
